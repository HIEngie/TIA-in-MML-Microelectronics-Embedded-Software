menu* make_node(menu* father,char NAME[],int DATA,int TYPE)//插入节点函数，插入为子菜单的最后一栏  
{  
  
    menu *ans=(menu *)malloc(sizeof(menu));  
    ans->data=DATA;  
    ans->name=NAME;  
    if (father->son!=NULL)  
    {  
        menu *tmp=father->son;  
        tmp->maxn++;  
        menu* pp=father->son;  
        while (tmp->next!=pp)  
        {  
            tmp=tmp->next;  
            tmp->maxn++;  
        }  
        tmp->next=ans;  
        ans->locy=tmp->locy+1;  
        ans->next=father->son;  
        ans->last=tmp;  
        ans->parent=father;  
        ans->maxn=tmp->maxn;  
        pp->last=ans;  
    }  
    else  
    {  
        father->son=ans;  
        ans->locy=1;  
        ans->maxn=1;  
        ans->parent=father;  
        ans->next=ans;  
        ans->last=ans;  
    }  
    ans->son=NULL;  
    ans->type=TYPE;  
    return ans;  
}  
  
