void change(int type,menu* qq)//参数按位调参  
{  
    int toch;  
    int i;  
    for (i=0;i<100;i++)//每次都要改  
    {  
        if (strcmp(qq->name,data_name[i])==0)  
        {  
            toch=i;  
            break;  
        }  
    }  
    int rate=1;//调参分度值  
    int dxx;  
    if (type==1)//整形调参  
    {  
        print_data(qq,rate,1);  
        while (dxx=get())  
        {  
            system_delay_ms(200);  
            switch(dxx)  
            {  
                case 3://左移  
                    if (rate==1)  
                    {  
                        break;  
                    }  
                    rate=rate/10;  
                    print_data(qq,rate,1);  
                    break;  
                case 4://右移  
                    if (rate==10000000000)  
                    {  
                        break;  
                    }  
                    rate=rate*10;  
                    print_data(qq,rate,1);  
                    break;  
                case 1://上调  
                    if (qq->data-rate<0)  
                        break;  
                    qq->data=qq->data-rate;  
                    data_small[toch]=qq->data;  
                    print_data(qq,rate,1);  
                    break;  
                case 2://下调  
                    qq->data=qq->data+rate;  
                    data_small[toch]=qq->data;  
                    print_data(qq,rate,1);  
                    break;  
                case 5:  
                {  
                    data_small[toch]=qq->data;  
                    return ;  
                }  
                default://否则无操作  
                    ;  
            }  
        }  
    }  
    else if(type==2)//浮点数调参  
    {  
        print_data(qq,rate,2);  
        while (dxx=get())  
        {  
  
            switch(dxx)  
            {  
                case 3:  
                    if (rate==1)  
                    {  
                        break;  
                    }  
                    rate=rate/10;  
                    print_data(qq,rate,2);  
                    break;  
                case 4:  
                    if (rate==100000)  
                    {  
                        break;  
                    }  
                    rate=rate*10;  
                    print_data(qq,rate,2);  
                    break;  
                case 1:  
                    qq->data=qq->data-rate;  
                    data_small[toch]=qq->data;  
                    print_data(qq,rate,2);  
                    break;  
                case 2:  
                    qq->data=qq->data+rate;  
                    data_small[toch]=qq->data;  
                    print_data(qq,rate,2);  
                    break;  
                case 5:  
                {  
                    data_small[toch]=qq->data;  
                    return ;  
                }  
                default:  
                    ;  
            }  
        }  
    }  
}  
  
